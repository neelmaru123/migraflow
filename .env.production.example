# ==============================================================================
# Migraflow Platform - Production Environment Configuration Template (.env.production)
# Copy this file to '.env' on your production server (e.g. EC2 instance)
# and adjust your server IP/domain and API keys.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Migraflow API"
ENVIRONMENT="production"
LOG_LEVEL="INFO"

# Cryptographically Secure Production Keys (Replace or use generated 256-bit keys below)
SECRET_KEY="099b4b4cd041aac731d6f92587f2ecba8a63943386e52d5ecc0cb75c7654d493"
JWT_SECRET_KEY="07e7dbe717bb29263fb626af239df7a10a554c5eb1efd459cdb268d08b54b45c"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
API_V1_STR="/api/v1"

# Production Host & IP Configuration
# Enter your server's public IP (e.g. 54.210.12.34) or domain (e.g. migraflow.yourdomain.com):
HOST_IP="127.0.0.1"

# When using Nginx reverse proxy (standard docker-compose.prod.yml):
# Frontend and API both serve through Nginx on port 80 / 443.
# If deploying directly without Nginx reverse proxy:
#   FRONTEND_URL="http://${HOST_IP}:3000"
#   BACKEND_URL="http://${HOST_IP}:8000"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"

# CORS Configuration
# Comma-separated list of allowed origins. The backend automatically appends FRONTEND_URL & HOST_IP.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Cookie Security
# Set to 'true' if serving over HTTPS (SSL). Set to 'false' if serving directly over HTTP IP.
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"

# Public Docker Registry Image for the Migration Agent
# Set to the official public image so end-users can run the agent locally without building code:
AGENT_DOCKER_IMAGE="nmaru094123/data-migration-agent:latest"

# PostgreSQL Database (Docker Compose Internal)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password_prod"
POSTGRES_DB="migration_platform"
POSTGRES_PORT=5434

# Redis URL for Celery / Task Queue & Cache
DOCKER_REDIS_URL="redis://redis:6379/0"

# AI Reasoning Engine Configuration (Google Gemini or OpenAI)
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.5-flash-lite"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=360.0

# Cloud Execution Capacity Limits
MAX_CLOUD_ROWS=500000
MAX_CLOUD_SIZE_MB=100.0

# Optional LangSmith AI Observability (UK GDPR Compliant: false by default)
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="migraflow-platform"

# Google Gmail SMTP Settings for Password Reset & Transactional Emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL=""
EMAILS_FROM_NAME="Migraflow Platform"
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=5
RESET_PASSWORD_COOLDOWN_SECONDS=60

# Optional Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
